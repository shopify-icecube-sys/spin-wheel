{%- assign wheel_settings = app.metafields.wheelify.settings.value -%}
{%- assign wheel_config = app.metafields.wheelify.config.value -%}

{%- assign popup_pos = 'bottom-right' -%}
{%- assign trigger_text = 'Spin & Win!' -%}
{%- assign popup_title = "Valentine's Day Sale!" -%}
{%- assign popup_subtitle = 'Enter your email to get a chance to win a discount!' -%}
{%- assign form_btn_text = 'TRY YOUR LUCK!' -%}
{%- assign spin_btn_text = '🎯 Spin to Win!' -%}
{%- assign form_disclaimer = '' -%}
{%- assign custom_cooldown = 30 -%}
{%- assign expiry_minutes = 60 -%}

{%- assign trigger_bg_color = '#ff4d6d' -%}
{%- assign trigger_bg_color_dark = '#c9184a' -%}

{%- if wheel_settings -%}
  {%- if wheel_settings.popupPosition != null -%}{%- assign popup_pos = wheel_settings.popupPosition -%}{%- endif -%}
  {%- if wheel_settings.triggerText != null -%}{%- assign trigger_text = wheel_settings.triggerText -%}{%- endif -%}
  {%- if wheel_settings.popupTitle != null -%}{%- assign popup_title = wheel_settings.popupTitle -%}{%- endif -%}
  {%- if wheel_settings.popupSubtitle != null -%}
    {%- assign popup_subtitle = wheel_settings.popupSubtitle -%}
  {%- endif -%}
  {%- if wheel_settings.formButtonText != null -%}
    {%- assign form_btn_text = wheel_settings.formButtonText -%}
  {%- endif -%}
  {%- if wheel_settings.spinButtonText != null -%}
    {%- assign spin_btn_text = wheel_settings.spinButtonText -%}
  {%- endif -%}
  {%- if wheel_settings.formDisclaimer != null -%}
    {%- assign form_disclaimer = wheel_settings.formDisclaimer -%}
  {%- endif -%}

  {%- if wheel_settings.customCooldownDays != null -%}
    {%- assign custom_cooldown = wheel_settings.customCooldownDays -%}
  {%- endif -%}
  {%- if wheel_settings.couponExpiryMinutes != null -%}
    {%- assign expiry_minutes = wheel_settings.couponExpiryMinutes -%}
  {%- endif -%}
  {%- if wheel_settings.triggerColor != null -%}
    {%- assign trigger_bg_color = wheel_settings.triggerColor -%}
    {%- assign trigger_bg_color_dark = trigger_bg_color -%}
  {%- elsif wheel_settings.themeColor != null -%}
    {%- assign trigger_bg_color = wheel_settings.themeColor -%}
    {%- assign trigger_bg_color_dark = trigger_bg_color -%}
  {%- endif -%}
{%- endif -%}

<div id="wheelify-root">
  <!-- Floating Trigger Button -->
  <button id="wheelify-trigger" aria-label="Spin the Wheel">
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32">
      <circle cx="32" cy="32" r="30" stroke="white" stroke-width="4"/>
      <line x1="32" y1="2" x2="32" y2="62" stroke="white" stroke-width="3"/>
      <line x1="2" y1="32" x2="62" y2="32" stroke="white" stroke-width="3"/>
      <line x1="9" y1="9" x2="55" y2="55" stroke="white" stroke-width="3"/>
      <line x1="55" y1="9" x2="9" y2="55" stroke="white" stroke-width="3"/>
      <circle cx="32" cy="32" r="8" fill="white"/>
    </svg>
    {%- if trigger_text != '' -%}
      <span>{{ trigger_text }}</span>
    {%- endif -%}
  </button>

  <!-- Popup Overlay -->
  <div id="wheelify-overlay">
    <div id="wheelify-popup">
      <button id="wheelify-close">✕</button>

      <div id="wheelify-container">
        <!-- Left: Wheel Section -->
        <div id="wheelify-wheel-section">
          <div id="wheelify-wheel-wrap">
            <div id="wheelify-pointer"></div>
            <canvas id="wheelify-canvas" width="460" height="460"></canvas>
            <div id="wheelify-hub"></div>
          </div>
        </div>

        <!-- Right: Content Section -->
        <div id="wheelify-content-section">
          <div id="wheelify-content-inner">
            {%- if popup_title != '' -%}
              <h2 id="wheelify-title">{{ popup_title }}</h2>
            {%- endif -%}
            {%- if popup_subtitle != '' -%}
              <p id="wheelify-subtitle">{{ popup_subtitle }}</p>
            {%- endif -%}

            <!-- Step 1: Lead Gen Form -->
            <div id="wheelify-step-1">
              <div class="wheelify-input-group">
                <input type="email" id="wheelify-email" placeholder="Email" aria-label="Email" required>
              </div>
              <button id="wheelify-submit-btn">{{ form_btn_text }}</button>
              <p
                id="wheelify-error"
                style="display:none; color:#ff4d4d; font-size:12px; margin-top:8px; font-weight:600;"
              ></p>
            </div>

            <!-- Step 2: Spin Action (Hidden initially) -->
            <div id="wheelify-step-2" style="display:none;">
              <button id="wheelify-spin-btn">{{ spin_btn_text }}</button>
            </div>

            <!-- Step 3: Result Panel -->
            <div id="wheelify-result" style="display:none;">
              <p id="wheelify-result-msg"></p>
              <div id="wheelify-coupon-wrap">
                <span id="wheelify-coupon-code"></span>
                <button id="wheelify-copy-btn">Copy</button>
              </div>
              <p id="wheelify-applied-msg" style="display:none;"></p>
            </div>

            <!-- Step 4: Cooldown Warning -->
            <div id="wheelify-cooldown" style="display:none;">
              <div style="font-size: 50px; margin-bottom: 15px;">⏳</div>
              <p
                id="wheelify-cooldown-msg"
                style="color: #ff4d6d; font-weight: 800; font-size: 20px; line-height: 1.4;"
              ></p>
            </div>

            {%- if form_disclaimer != '' -%}
              <p id="wheelify-disclaimer">{{ form_disclaimer }}</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Timer Bar -->
  <div id="wheelify-sticky-timer" style="display:none;">
    <div id="wheelify-timer-content">
      🎉 Use code <strong id="wheelify-timer-code"></strong> for <strong id="wheelify-timer-discount"></strong> OFF!
      Expires in <strong id="wheelify-timer-countdown"></strong>
    </div>
    <button id="wheelify-timer-copy">Copy Code</button>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap');

  #wheelify-root {
    font-family: 'Outfit', sans-serif;
  }

  #wheelify-sticky-timer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #002c44;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 12px 20px;
    z-index: 999999;
    box-shadow: 0 -4px 15px rgba(0,0,0,0.15);
    font-size: 16px;
    gap: 16px;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  #wheelify-sticky-timer.active {
    transform: translateY(0);
  }

  #wheelify-timer-content {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  #wheelify-timer-countdown {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 18px;
    letter-spacing: 1px;
  }

  #wheelify-timer-code {
    background: #fff;
    color: #ff051e;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: monospace;
    font-weight: 800;
  }

  #wheelify-timer-copy {
    background: #fff;
    color: #ff051e;
    border: none;
    padding: 6px 16px;
    border-radius: 6px;
    font-weight: 800;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    transition: background 0.2s, transform 0.1s;
  }

  #wheelify-timer-copy:active {
    transform: scale(0.95);
  }

  #wheelify-timer-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    font-size: 20px;
    cursor: pointer;
    position: absolute;
    right: 20px;
  }

  #wheelify-timer-close:hover {
    color: #fff;
  }

  @media (max-width: 600px) {
    #wheelify-sticky-timer {
      flex-direction: column;
      padding: 16px 12px;
      font-size: 14px;
      text-align: center;
    }
    #wheelify-timer-content {
      flex-direction: column;
      gap: 8px;
    }
    #wheelify-timer-close {
      top: 8px;
      right: 12px;
    }
  }

  #wheelify-trigger {
    position: fixed;
    bottom: 24px;
    {%- if popup_pos == 'bottom-left' -%}left: 24px;{%- else -%}right: 24px;{%- endif -%}
    z-index: 9998;
    background: linear-gradient(135deg, {{ trigger_bg_color }}, {{ trigger_bg_color_dark }});
    color: white;
    border: none;
    border-radius: 50px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 8px 24px {{ trigger_bg_color | append: '66' }};
    animation: wheelifyPulse 2s infinite;
    transition: transform 0.2s;
  }
  #wheelify-trigger:hover { transform: translateY(-2px); }

  @keyframes wheelifyPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 8px 24px {{ trigger_bg_color | append: '66' }}; }
    50% { transform: scale(1.05); box-shadow: 0 12px 32px {{ trigger_bg_color | append: '99' }}; }
  }

  #wheelify-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    padding: 20px;
  }
  #wheelify-overlay.active { display: flex; }

  #wheelify-popup {
    background: #fff;
    background-size: cover;
    background-position: center;
    border-radius: 32px;
    width: 100%;
    max-width: 1000px;
    min-height: 500px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 40px 100px rgba(0,0,0,0.5);
    display: flex;
  }

  #wheelify-container {
    display: flex;
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }

  #wheelify-wheel-section {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    position: relative;
    overflow: hidden;
  }

  #wheelify-content-section {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    background: rgba(255, 255, 255, 0.85);
    text-align: center;
  }

  @media (max-width: 768px) {
    #wheelify-popup { flex-direction: column; max-width: 400px; max-height: 90vh; overflow-y: auto; }
    #wheelify-container { flex-direction: column; }
    #wheelify-wheel-section { padding: 20px; }
    #wheelify-canvas { width: 320px !important; height: 320px !important; }
    #wheelify-wheel-wrap { width: 320px !important; height: 320px !important; }
  }

  #wheelify-close {
    position: absolute;
    top: 20px; right: 20px;
    background: rgba(0,0,0,0.1);
    border: none;
    color: #333;
    font-size: 20px;
    border-radius: 50%;
    width: 40px; height: 40px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 10;
    transition: background 0.2s;
  }
  #wheelify-close:hover { background: rgba(0,0,0,0.2); }

  #wheelify-title {
    font-size: 42px;
    font-weight: 800;
    margin: 0 0 16px;
    color: #002c44;
    line-height: 1.1;
  }

  #wheelify-subtitle {
    margin: 0 0 32px;
    color: #002c44;
    font-size: 17px;
    line-height: 1.5;
  }

  .wheelify-input-group {
    margin-bottom: 16px;
    width: 100%;
  }

  #wheelify-email {
    width: 100%;
    padding: 16px 24px;
    border: 2px solid #eee;
    border-radius: 12px;
    font-size: 16px;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s;
    outline: none;
  }
  #wheelify-email:focus { border-color: #000; }

  #wheelify-submit-btn, #wheelify-spin-btn {
    width: 100%;
    background: #002c44;
    color: white;
    border: none;
    padding: 16px 32px;
    border-radius: 12px;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  #wheelify-submit-btn:hover, #wheelify-spin-btn:hover { background: #333; transform: translateY(-2px); }
  #wheelify-submit-btn:disabled, #wheelify-spin-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  #wheelify-disclaimer {
    font-size: 12px;
    color: #002c44;
    margin-top: 24px;
    line-height: 1.4;
  }

  #wheelify-wheel-wrap {
    position: relative;
    width: 460px; height: 460px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  #wheelify-pointer {
    position: absolute;
    top: 50%; right: -20px;
    transform: translateY(-50%) rotate(90deg);
    width: 0; height: 0;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-top: 30px solid #000;
    z-index: 10;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));
  }
  #wheelify-canvas {
    display: block;
    filter: drop-shadow(0 10px 30px rgba(0,0,0,0.15));
  }
  #wheelify-hub {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 40px; height: 40px;
    background: white;
    border-radius: 50%;
    z-index: 5;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #wheelify-hub::after {
    content: '★';
    color: #000;
    font-size: 20px;
  }

  #wheelify-result {
    background: #f9f9f9;
    border-radius: 16px;
    padding: 24px;
    width: 100%;
    margin-top: 20px;
    box-sizing: border-box;
    border: 2px dashed #000;
  }
  #wheelify-result-msg { font-size: 18px; font-weight: 700; margin: 0 0 16px; color: #333; }
  #wheelify-coupon-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
    background: white;
    border-radius: 12px;
    padding: 12px 16px;
    border: 1px solid #eee;
  }
  #wheelify-coupon-code { font-size: 20px; font-weight: 800; letter-spacing: 2px; color: #ff4d6d; }
  #wheelify-copy-btn {
    background: #ff4d6d;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
  }
  #wheelify-applied-msg { margin-top: 12px; font-size: 16px; color: #27ae60; font-weight: 700; }

  /* Spinner Styles */
  .wheelify-loader {
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: wheelify-spin 0.8s linear infinite;
    display: inline-block;
    vertical-align: middle;
    margin-right: 8px;
  }
  @keyframes wheelify-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  (function() {
    // --- Load Config ---
    // --- Load Config ---
    var slices = [
      {%- if wheel_config -%}
        {%- for slice in wheel_config limit: 10 -%}
          {
            label: {{ slice.label | json }},
            winText: {{ slice.winText | json }},
            discountValue: {{ slice.discountValue | json }},
            gravity: {{ slice.gravity | default: 10 }},
            color: {{ slice.color | default: "#ff4d6d" | json }},
            type: {{ slice.type | default: "Win" | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        { label: '10% OFF', discountValue: '10', gravity: 35, color: '#ff4d6d', type: 'Win' },
        { label: '20% OFF', discountValue: '20', gravity: 25, color: '#ff758f', type: 'Win' },
        { label: '30% OFF', discountValue: '30', gravity: 20, color: '#ff85a1', type: 'Win' },
        { label: '40% OFF', discountValue: '40', gravity: 15, color: '#ff99ac', type: 'Win' },
        { label: '50% OFF', discountValue: '50', gravity: 5, color: '#ff4d6d', type: 'Win' }
      {%- endif -%}
    ];

    // Slices are now fully managed from the Admin Panel

    // --- Elements ---
    var trigger = document.getElementById('wheelify-trigger');
    var overlay = document.getElementById('wheelify-overlay');
    var closeBtn = document.getElementById('wheelify-close');
    var submitBtn = document.getElementById('wheelify-submit-btn');
    var spinBtn = document.getElementById('wheelify-spin-btn');
    var emailInput = document.getElementById('wheelify-email');
    var errorMsg = document.getElementById('wheelify-error');
    var step1 = document.getElementById('wheelify-step-1');
    var step2 = document.getElementById('wheelify-step-2');
    var resultPanel = document.getElementById('wheelify-result');
    var resultMsg = document.getElementById('wheelify-result-msg');
    var couponCode = document.getElementById('wheelify-coupon-code');
    var copyBtn = document.getElementById('wheelify-copy-btn');
    var appliedMsg = document.getElementById('wheelify-applied-msg');
    var canvas = document.getElementById('wheelify-canvas');
    var ctx = canvas.getContext('2d');
    // Support for letter spacing in canvas if available
    if ('letterSpacing' in ctx) {
      ctx.letterSpacing = '0.5px';
    }
    var userEmail = '';
    var currentCustomerId = '';

    // --- Cooldown Logic ---
    var customDays = {{ custom_cooldown | json }};
    var storageKey = 'wheelify_spun';
    var cooldownPanel = document.getElementById('wheelify-cooldown');
    var cooldownMsg = document.getElementById('wheelify-cooldown-msg');

    function checkCooldown() {
      var storedValue = localStorage.getItem(storageKey);
      if (!storedValue) return false;

      var diff = Date.now() - parseInt(storedValue);
      var cooldownMs = customDays * 24 * 60 * 60 * 1000;

      if (diff < cooldownMs) {
        var remainingMs = cooldownMs - diff;
        var remainingDays = Math.ceil(remainingMs / (24 * 60 * 60 * 1000));
        return remainingDays;
      }
      return false;
    }

    // --- Draw Wheel ---
    var numSlices = slices.length;
    var sliceAngle = (2 * Math.PI) / numSlices;
    var currentRotation = 0;

    function drawWheel(rotation) {
      ctx.clearRect(0, 0, 460, 460);
      var cx = 230, cy = 230, radius = 220;

      // Outer white ring border
      ctx.beginPath();
      ctx.arc(cx, cy, radius + 8, 0, 2 * Math.PI);
      ctx.fillStyle = 'white';
      ctx.fill();

      slices.forEach(function(slice, i) {
        var startAngle = rotation + i * sliceAngle;
        var endAngle = startAngle + sliceAngle;

        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radius, startAngle, endAngle);
        ctx.closePath();
        ctx.fillStyle = slice.color;
        ctx.fill();

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(startAngle + sliceAngle / 2);
        ctx.textAlign = 'center';
        ctx.fillStyle = 'white';

        // Shadow for maximum contrast/readability
        ctx.shadowColor = 'rgba(0,0,0,0.8)';
        ctx.shadowBlur = 5;
        ctx.shadowOffsetX = 1;
        ctx.shadowOffsetY = 1;

        // Uniform larger font size for high visibility
        ctx.font = 'bold 17px Outfit, sans-serif';
        ctx.textBaseline = 'middle';

        // Precise positioning (Hub at 20, Outer at 220, Balanced at 130 for 17px font)
        ctx.fillText(slice.label, 130, 0);
        ctx.restore();
      });
    }

    drawWheel(currentRotation);

    // --- Step 1: Lead Gen ---
    submitBtn.addEventListener('click', function() {
      var email = emailInput.value;
      if (!email || !email.includes('@')) {
        errorMsg.textContent = 'Please enter a valid email address.';
        errorMsg.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="wheelify-loader"></span> Processing...';
      errorMsg.style.display = 'none';

      var formData = new URLSearchParams();
      formData.append('action', 'create_customer');
      formData.append('email', email);
      formData.append('cooldownDays', {{ custom_cooldown | json }});

      fetch('/apps/wheelify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: formData })
      .then(function(res) {
        if (!res.ok) {
          if (res.status === 504 || res.status === 502) {
            throw new Error('Server timeout. Please try again in a moment.');
          }
          return res.text().then(function(text) { throw new Error('Server error (' + res.status + ')'); });
        }
        return res.json();
      })
      .then(function(data) {
        if (data.success) {
          userEmail = email;
          currentCustomerId = data.customerId || '';
          step1.style.display = 'none';
          step2.style.display = 'block';
        } else {
          errorMsg.textContent = data.error || 'Something went wrong. Please try again.';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = {{ form_btn_text | json }};
        }
      })
      .catch(function(err) {
        console.error('Lead Capture Error:', err);
        errorMsg.textContent = err.message.includes('fetch') ? 'Connection error. Please check your internet.' : err.message;
        errorMsg.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = {{ form_btn_text | json }};
      });
    });

    // --- Step 2: Spin ---
    var isSpinning = false;
    spinBtn.addEventListener('click', function() {
      if (isSpinning) return;
      isSpinning = true;
      spinBtn.disabled = true;

      // --- Proper Linear Weighted Logic ---
      var totalWeight = slices.reduce(function(sum, s) {
          return sum + (parseFloat(s.gravity) || 0);
      }, 0);

      if (totalWeight <= 0) totalWeight = slices.length; // Fallback

      var rand = Math.random() * totalWeight;
      var cumulative = 0;
      var winnerIndex = 0;

      for (var i = 0; i < slices.length; i++) {
        var g = parseFloat(slices[i].gravity) || 0;
        if (totalWeight === slices.length) g = 1; // Fallback
        cumulative += g;
        if (rand <= cumulative) {
          winnerIndex = i;
          break;
        }
      }

      console.log("Spin started. Winner Index:", winnerIndex, "Label:", slices[winnerIndex].label);

      var winnerAngle = sliceAngle * winnerIndex;
      // Pointer is at the RIGHT (0 rad)
      var targetAngle = 0 - (winnerAngle + sliceAngle / 2);
      var extraSpins = (6 + Math.floor(Math.random() * 4)) * 2 * Math.PI;
      var finalRotation = currentRotation + extraSpins + (targetAngle - (currentRotation % (2 * Math.PI)));

      var startTime = null;
      var duration = 5000;
      var startRot = currentRotation;

      function animate(timestamp) {
        if (!startTime) startTime = timestamp;
        var progress = Math.min((timestamp - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 4);
        currentRotation = startRot + (finalRotation - startRot) * eased;
        drawWheel(currentRotation);
        if (progress < 1) requestAnimationFrame(animate);
        else {
          isSpinning = false;
          showResult(winnerIndex);
        }
      }
      requestAnimationFrame(animate);
    });

    function showResult(winnerIndex) {
      var winner = slices[winnerIndex];
      localStorage.setItem(storageKey, Date.now().toString());
      step2.style.display = 'none';
      resultPanel.style.display = 'block';

      // Robust win check: Check the slice type
      var isWin = winner.type === 'Win';

      // --- Server-side recording & Coupon generation ---
      if (isWin) {
        resultMsg.textContent = '🎉 You won: ' + (winner.winText || winner.label);
        document.getElementById('wheelify-coupon-wrap').style.display = 'flex';
        couponCode.textContent = 'Generating...';
      } else {
        resultMsg.textContent = winner.winText || winner.label || 'Better luck next time!';
        document.getElementById('wheelify-coupon-wrap').style.display = 'none';
      }

      appliedMsg.style.display = 'none';

      var formData = new URLSearchParams();
      formData.append('action', 'record_lead');
      formData.append('label', winner.label);
      // Priority: 1. winner.discountValue, 2. Regex from label, 3. Default "10"
      var dv = winner.discountValue;
      if (!dv && winner.label) {
        var match = winner.label.match(/(\d+(?:\.\d+)?)/);
        if (match) dv = match[1];
      }
      formData.append('discountValue', dv || '10');
      formData.append('email', userEmail);
      formData.append('customerId', currentCustomerId);

      formData.append('expiryMinutes', {{ expiry_minutes | json }});
      formData.append('isWin', isWin ? 'true' : 'false'); // Tell server if it was a win

      fetch('/apps/wheelify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: formData })
      .then(function(res) {
        if (!res.ok) throw new Error('Server error during spin record.');
        return res.json();
      })
      .then(function(data) {
        if (data.code) {
          couponCode.textContent = data.code;
          var msg = '✅ Copy the code and use it at checkout!';
          {% if expiry_minutes > 0 %}
            msg += ' <br><span style="font-size: 12px; opacity: 0.8;">Note: This code expires in {{ expiry_minutes }} minutes.</span>';

            // Setup Sticky Timer
            var expiryMs = Date.now() + ({{ expiry_minutes }} * 60000);
            localStorage.setItem('wheelify_coupon_code', data.code);
            localStorage.setItem('wheelify_coupon_expiry', expiryMs.toString());
            localStorage.setItem('wheelify_coupon_label', winner.label);
            checkStickyTimer();
          {% endif %}
          appliedMsg.innerHTML = msg;
          appliedMsg.style.display = 'block';
        } else if (data.success) {
          // Successfully recorded a loss
          console.log("Loss recorded successfully.");
        } else if (data.error && isWin) {
          couponCode.textContent = 'ERROR';
          appliedMsg.textContent = '❌ ' + data.error;
          appliedMsg.style.color = '#ff4d4d';
          appliedMsg.style.display = 'block';
        }
      })
      .catch(function(err) {
        console.error('Spin Result Sync Error:', err);
        if (isWin) {
          couponCode.textContent = 'ERROR';
          appliedMsg.textContent = '⚠️ Result not saved, but you won! Please take a screenshot.';
          appliedMsg.style.display = 'block';
        }
      });
    }

    // --- Sticky Timer Logic ---
    var stickyTimer = document.getElementById('wheelify-sticky-timer');
    var timerCountdown = document.getElementById('wheelify-timer-countdown');
    var timerCode = document.getElementById('wheelify-timer-code');
    var timerDiscount = document.getElementById('wheelify-timer-discount');
    var timerCopy = document.getElementById('wheelify-timer-copy');
    var timerInterval = null;

    function formatTime(ms) {
      var totalSec = Math.floor(ms / 1000);
      var m = Math.floor(totalSec / 60);
      var s = totalSec % 60;
      return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }

    function checkStickyTimer() {
      var code = localStorage.getItem('wheelify_coupon_code');
      var expiry = localStorage.getItem('wheelify_coupon_expiry');
      var label = localStorage.getItem('wheelify_coupon_label');

      if (!code || !expiry || !label) return;

      var diff = parseInt(expiry) - Date.now();
      if (diff <= 0) {
        // One final check to see if it was used before it expired
        performStatusCheck(true);
        return;
      }

      // SHOW TIMER IMMEDIATELY
      timerCode.textContent = code;
      var match = label.match(/(\d+)\s*(?:%|PERCENT|OFF)/i);
      timerDiscount.textContent = match ? match[1] + '%' : label;

      stickyTimer.style.display = 'flex';
      setTimeout(function() { stickyTimer.classList.add('active'); }, 50);

      if (timerInterval) clearInterval(timerInterval);

      timerInterval = setInterval(function() {
        var newDiff = parseInt(expiry) - Date.now();
        if (newDiff <= 0) {
          hideStickyTimer();
        } else {
          timerCountdown.textContent = formatTime(newDiff);
        }
      }, 1000);

      timerCountdown.textContent = formatTime(diff);

      var checkCount = 0;
      var isChecking = false;

      function performStatusCheck(hideIfUnused) {
        if (isChecking) return;
        var activeCode = localStorage.getItem('wheelify_coupon_code');
        if (!activeCode) {
          if (window.wheelifyPollInterval) clearInterval(window.wheelifyPollInterval);
          return;
        }

        checkCount++;

        // Dynamic Interval: Check faster if close to expiry
        var timeRemaining = parseInt(localStorage.getItem('wheelify_coupon_expiry')) - Date.now();
        var nextInterval = 10000; // default 10s

        // INSTANT CHECK: If we just came from checkout, poll very fast (2s) for the first minute
        var isFromCheckout = document.referrer.indexOf('/checkouts/') !== -1;

        if (isFromCheckout && checkCount < 30) {
          nextInterval = 2000; // 2s
        } else if (timeRemaining < 30000 && timeRemaining > 0) {
          nextInterval = 5000; // 5s if less than 30s left
        } else if (checkCount >= 40) {
          nextInterval = 20000; // 20s if polled for long time
        }

        if (window.wheelifyPollInterval) {
           clearInterval(window.wheelifyPollInterval);
           window.wheelifyPollInterval = setInterval(performStatusCheck, nextInterval);
        }

        // Only poll if tab is visible
        if (document.visibilityState !== 'visible') return;

        var formData = new URLSearchParams();
        formData.append('action', 'check_coupon_status');
        formData.append('code', activeCode);
        formData.append('expiryMinutes', {{ expiry_minutes | json }});

        isChecking = true;
        fetch('/apps/wheelify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          isChecking = false;
          if (data && data.used) {
            showSuccess(activeCode);
          } else if (hideIfUnused) {
            hideStickyTimer();
          }
        })
        .catch(function(err) {
          isChecking = false;
          console.error("Timer check failed:", err);
          if (hideIfUnused) hideStickyTimer();
        });
      }

      function showSuccess(code) {
        if (timerInterval) clearInterval(timerInterval);
        if (window.wheelifyPollInterval) clearInterval(window.wheelifyPollInterval);

        localStorage.removeItem('wheelify_coupon_code');
        localStorage.removeItem('wheelify_coupon_expiry');
        localStorage.removeItem('wheelify_coupon_label');

        stickyTimer.innerHTML = '🎉 Order Confirmed! Your coupon <strong>' + code + '</strong> was successfully used.';
        stickyTimer.style.background = '#005f2c';
        stickyTimer.style.display = 'flex';
        setTimeout(function() { stickyTimer.classList.add('active'); }, 50);

        setTimeout(function() {
          stickyTimer.classList.remove('active');
          setTimeout(function() { stickyTimer.style.display = 'none'; }, 400);
        }, 5000);
      }

      // Start with a 10-second interval to reduce server load
      window.wheelifyPollInterval = setInterval(performStatusCheck, 10000);
      performStatusCheck(); // Immediate first check
    }

    function hideStickyTimer() {
      var code = localStorage.getItem('wheelify_coupon_code');
      if (code) {
        var formData = new URLSearchParams();
        formData.append('action', 'expire_coupon');
        formData.append('code', code);
        formData.append('expiryMinutes', {{ expiry_minutes | json }});
        fetch('/apps/wheelify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: formData });
      }

      if (timerInterval) clearInterval(timerInterval);
      if (window.wheelifyPollInterval) clearInterval(window.wheelifyPollInterval);
      stickyTimer.classList.remove('active');
      setTimeout(function() { stickyTimer.style.display = 'none'; }, 400);
      localStorage.removeItem('wheelify_coupon_code');
      localStorage.removeItem('wheelify_coupon_expiry');
      localStorage.removeItem('wheelify_coupon_label');
    }

    timerCopy.addEventListener('click', function() {
      navigator.clipboard.writeText(timerCode.textContent).then(function() {
        timerCopy.textContent = 'Copied!';
        setTimeout(function() { timerCopy.textContent = 'Copy Code'; }, 2000);
      });
    });

    checkStickyTimer(); // Run on page load

    copyBtn.addEventListener('click', function() {
      navigator.clipboard.writeText(couponCode.textContent).then(function() {
        copyBtn.textContent = 'Copied!';
        setTimeout(function() { copyBtn.textContent = 'Copy'; }, 2000);
      });
    });

    trigger.addEventListener('click', function() {
      // --- Trigger Background Cleanup only when someone opens the wheel ---
      var cleanupFormData = new URLSearchParams();
      cleanupFormData.append('action', 'cleanup_expired');
      cleanupFormData.append('expiryMinutes', {{ expiry_minutes | json }});
      fetch('/apps/wheelify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: cleanupFormData })
      .catch(function(err) { console.error("Cleanup trigger failed:", err); });

      var remainingDays = checkCooldown();
      if (remainingDays) {
        step1.style.display = 'none';
        step2.style.display = 'none';
        resultPanel.style.display = 'none';
        cooldownPanel.style.display = 'block';
        cooldownMsg.textContent = 'Wait! You can spin the wheel again after ' + remainingDays + (remainingDays === 1 ? ' day.' : ' days.');
      } else {
        cooldownPanel.style.display = 'none';
        // Normal logic: show step 1 or 2
        step1.style.display = 'block';
      }
      overlay.classList.add('active');
    });
    closeBtn.addEventListener('click', function() { overlay.classList.remove('active'); });


    // --- Initial Check to Hide Trigger ---
    if (checkCooldown()) {
      trigger.style.display = 'none';
    }
  })();
</script>

